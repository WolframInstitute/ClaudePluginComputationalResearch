\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{macros}

% ── Fonts and math (amssymb before newpxmath to avoid \Bbbk conflict) ──
\RequirePackage{newpxtext}
\RequirePackage[T1]{fontenc}
\RequirePackage{amsthm,amsfonts,amsmath,amssymb}
\RequirePackage{newpxmath}
\RequirePackage{microtype}
\RequirePackage{mathtools}
\RequirePackage{mathrsfs}

% ── Graphics and TikZ ──
\RequirePackage{graphicx}
\RequirePackage{tikz}
\RequirePackage{tikz-cd}
\RequirePackage{subcaption}
\usetikzlibrary{calc,arrows.meta,decorations.markings,positioning}

% ── Tables ──
\RequirePackage{booktabs}
\RequirePackage{array}

% ── Colors ──
\RequirePackage{xcolor}

% ── Hyperlinks ──
\RequirePackage[
  colorlinks=true,
  linkcolor=blue!70!black,
  citecolor=red!70!black,
  urlcolor=magenta!80!black
]{hyperref}

% ── Smart references (after hyperref) ──
% nosort is required, not cosmetic: with the aliased counters below, cleveref's
% default range compression silently DROPS entries from a multi-reference list.
\RequirePackage[nameinlink,capitalize,nosort]{cleveref}

% ── Bibliography ──
\RequirePackage[
  backend=biber,
  style=alphabetic,
  sorting=nyt,
  maxbibnames=99,
  doi=true,
  url=true,
  eprint=true
]{biblatex}
\addbibresource{references.bib}

% ── Layout ──
\RequirePackage{enumitem}
\setlist{leftmargin=5.5mm}

% ── Theorem environments ──
% One shared counter, but each environment needs its OWN counter name or
% cleveref reads the counter and calls every reference a "Theorem".
% aliascnt gives each an alias of the theorem counter, which keeps the shared
% numbering and lets cleveref name the environment.
\RequirePackage{aliascnt}

\newcommand{\sharedtheorem}[3]{%
  \newaliascnt{#1}{theorem}%
  \newtheorem{#1}[#1]{#2}%
  \aliascntresetthe{#1}%
  \crefname{#1}{#2}{#3}%
  \Crefname{#1}{#2}{#3}}

\theoremstyle{plain}
\newtheorem{theorem}{Theorem}[section]
\crefname{theorem}{Theorem}{Theorems}
\Crefname{theorem}{Theorem}{Theorems}
\sharedtheorem{corollary}{Corollary}{Corollaries}
\sharedtheorem{proposition}{Proposition}{Propositions}
\sharedtheorem{lemma}{Lemma}{Lemmas}
\sharedtheorem{conjecture}{Conjecture}{Conjectures}
\sharedtheorem{claim}{Claim}{Claims}

\theoremstyle{definition}
\sharedtheorem{definition}{Definition}{Definitions}
\sharedtheorem{example}{Example}{Examples}
\sharedtheorem{construction}{Construction}{Constructions}

\theoremstyle{remark}
\sharedtheorem{remark}{Remark}{Remarks}
\sharedtheorem{question}{Question}{Questions}
\sharedtheorem{observation}{Observation}{Observations}

% ── Operators ──
\DeclareMathOperator{\dist}{dist}
\DeclareMathOperator{\diam}{diam}
\DeclareMathOperator{\Aut}{Aut}
\DeclareMathOperator{\End}{End}
\DeclareMathOperator{\Hom}{Hom}

% ── Shorthand ──
\newcommand{\GG}{\mathcal{G}}
\newcommand{\VV}{\mathcal{V}}
\newcommand{\EE}{\mathcal{E}}
\newcommand{\NN}{\mathbb{N}}
\newcommand{\ZZ}{\mathbb{Z}}
\newcommand{\QQ}{\mathbb{Q}}
\newcommand{\RR}{\mathbb{R}}
\newcommand{\CC}{\mathbb{C}}
\newcommand{\FF}{\mathbb{F}}

% ── Code listings (Wolfram Language) ──
% style.md § Examples and § Ruliology both require the call that reproduces a
% computation, so the paper needs a verbatim environment a reader copies from.
\RequirePackage{listings}
\lstdefinestyle{wolframstyle}{
  basicstyle=\ttfamily\small,
  columns=fullflexible,
  keepspaces=true,
  breaklines=true,
  breakindent=0pt,
  breakatwhitespace=true,
  postbreak=\mbox{\textcolor{gray}{$\hookrightarrow$}\space},
  showstringspaces=false,
  aboveskip=1.4ex,
  belowskip=1.4ex,
  xleftmargin=1em
}
\lstnewenvironment{wolfram}{\lstset{style=wolframstyle}}{}
