Cell[BoxData["5"], "Output",
 CellID->28,ExpressionUUID->"7735f932-6baf-4be0-b2a4-3e4309e13b8a"]
}, {2}]],

Cell["Attainment, and the first failure", "Section",
 CellID->29,ExpressionUUID->"64fec44c-9c98-48b2-aed7-3bf9089047ac"],

Cell[TextData[{
 "The bound of ",
 ButtonBox["(",
  BaseStyle->"Citation",
  ButtonData->"Thm:Bound"],
 ButtonBox[
 CounterBox["DisplayFormulaNumbered", "Thm:Bound"],
  BaseStyle->"Citation",
  ButtonData->"Thm:Bound"],
 ButtonBox[")",
  BaseStyle->"Citation",
  ButtonData->"Thm:Bound"],
 " is met by every small cyclic group but not by all of them."
}], "Text",
 CellID->30,ExpressionUUID->"42851880-8414-4af5-997d-ccb8a081e500"],

Cell[TextData[{
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["s", "TI"], 
    RowBox[{"(", 
     StyleBox["n", "TI"], ")"}], "\[LongEqual]", 
    StyleBox["b", "TI"], 
    RowBox[{"(", 
     StyleBox["n", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d64d1821-8fe2-4813-9f2a-9f03b419c2a2"],
 " for every ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c1a684a6-cd5b-4a41-a36f-ec77c3018975"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"3", "\[LessEqual]", 
    StyleBox["n", "TI"], "\[LessEqual]", "21"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "dd1a6d89-0a0a-4383-b924-8c62b2737c1a"],
 ", and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["s", "TI"], 
    RowBox[{"(", "22", ")"}], "\[LongEqual]", "4", "<", "5", "\[LongEqual]", 
    StyleBox["b", "TI"], 
    RowBox[{"(", "22", ")"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a6d1b28a-a955-48e1-9666-5adf8de69971"],
 "."
}], "Proposition",
 CellTags->"Prop:First",
 CellID->31,ExpressionUUID->"6822087e-b801-46f7-811b-640d9f0e516a"],

Cell[TextData[{
 "The inequality ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["s", "TI"], 
    RowBox[{"(", 
     StyleBox["n", "TI"], ")"}], "\[LessEqual]", 
    StyleBox["b", "TI"], 
    RowBox[{"(", 
     StyleBox["n", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "3d566691-e957-45ea-8ab7-7856da336b5d"],
 " holds for all ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "51c5bc91-d507-4d09-b380-6163abb22e89"],
 " by ",
 ButtonBox["(",
  BaseStyle->"Citation",
  ButtonData->"Thm:Bound"],
 ButtonBox[
 CounterBox["DisplayFormulaNumbered", "Thm:Bound"],
  BaseStyle->"Citation",
  ButtonData->"Thm:Bound"],
 ButtonBox[")",
  BaseStyle->"Citation",
  ButtonData->"Thm:Bound"],
 " and the remark above it. For the positive half it therefore suffices to \
exhibit, for each ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c7f25c44-2b9f-462d-a57f-e667b6d78d39"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{"3", "\[LessEqual]", 
    StyleBox["n", "TI"], "\[LessEqual]", "21"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "31a02159-385b-4285-95b8-e601194fe75d"],
 ", one Sidon set of size ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["b", "TI"], "(", 
    StyleBox["n", "TI"], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6b7e9064-16f4-41d2-a099-987c7f61f553"],
 ", and the nineteen sets are listed in ",
 StyleBox["Ruliology", "TI"],
 ". For the negative half we must rule out a Sidon set of size ",
 Cell[BoxData[
  FormBox["5", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5282581a-0f25-424b-931d-e2a1d8a1ddc4"],
 " in ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["Z",
     FontSlant->"Plain"], "22"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "285743d2-fc03-40a0-bff5-014e76e319d0"],
 ". If ",
 Cell[BoxData[
  FormBox[
   StyleBox["A", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0bbf0479-85b1-48d9-af55-08feca2103d9"],
 " is a Sidon set then so is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["A", "TI"], "+", 
    StyleBox["t", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bbb29be6-4685-497c-94ae-5f9df6e30fd0"],
 " for every ",
 Cell[BoxData[
  FormBox[
   StyleBox["t", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "700c6366-8649-4079-9149-a103d61e1f4d"],
 ", since translation leaves every difference unchanged by ",
 ButtonBox["Definition ",
  BaseStyle->"Citation",
  ButtonData->"Def:Sidon"],
 ButtonBox[
 CounterBox["Section", "Def:Sidon"],
  BaseStyle->"Citation",
  ButtonData->"Def:Sidon"],
 ButtonBox[".",
  BaseStyle->"Citation",
  ButtonData->"Def:Sidon"],
 ButtonBox[
 CounterBox["Theorem", "Def:Sidon"],
  BaseStyle->"Citation",
  ButtonData->"Def:Sidon"],
 ", so we may assume ",
 Cell[BoxData[
  FormBox[
   RowBox[{"0", "\[Element]", 
    StyleBox["A", "TI"]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4e63f937-a91c-4a9c-a5a9-23ab04e4b5ee"],
 ". There are ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    TemplateBox[{"21", "4"},
     "Binomial"], "\[LongEqual]", "5985"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ac001e07-e301-4df9-a950-511a9b0dad25"],
 " five-element subsets of ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["Z",
     FontSlant->"Plain"], "22"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b56a06f4-b1af-46b9-a890-29f8dcb7d409"],
 " containing ",
 Cell[BoxData[
  FormBox["0", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "deaa162c-c6c0-4caa-9b3b-dac7a2507cae"],
 ", and testing each against ",
 ButtonBox["Definition ",
  BaseStyle->"Citation",
  ButtonData->"Def:Sidon"],
 ButtonBox[
 CounterBox["Section", "Def:Sidon"],
  BaseStyle->"Citation",
  ButtonData->"Def:Sidon"],
 ButtonBox[".",
  BaseStyle->"Citation",
  ButtonData->"Def:Sidon"],
 ButtonBox[
 CounterBox["Theorem", "Def:Sidon"],
  BaseStyle->"Citation",
  ButtonData->"Def:Sidon"],
 " finds none that is Sidon; the function ",
 Cell[BoxData["maxSidon"], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f801c6aa-1c12-41c4-94a1-fa03fd94e0ee"],
 " of the Initialization section performs that enumeration and returns ",
 Cell[BoxData[
  FormBox["4", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "7c4fc682-931a-43a2-9a36-d08db6525508"],
 ". Since a Sidon set of size ",
 Cell[BoxData[
  FormBox["4", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1d008bb4-c1ba-41ea-a48d-9db36f79d7cb"],
 " exists, namely ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "3", ",", "7"}], "}"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "c1564344-de6c-4dbe-b4ba-9e255b5d6f5d"],
 ", we get ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["s", "TI"], 
    RowBox[{"(", "22", ")"}], "\[LongEqual]", "4"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a18f1a42-b490-4b23-aaa8-1535004e65e8"],
 ".",
 " ",
 StyleBox["\[EmptySquare]", "QED"]
}], "Proof",
 CellID->32,ExpressionUUID->"7c753926-0e5b-4f0a-bdfb-6de0781d80e9"],

Cell[TextData[{
 "The maximum at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", "21"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1598015d-70a3-41c1-9142-d57a92163f08"],
 " is ",
 Cell[BoxData[
  FormBox["5", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "667da138-55f6-462b-83eb-1430a0331d7e"],
 ", attained by ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "4", ",", "14", ",", "16"}], "}"}], 
   TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1de33016-2318-4da2-b39d-7cfc891f6cc2"],
 "; the maximum at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", "22"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fd038b06-e754-4521-b21f-4931a0792990"],
 " is ",
 Cell[BoxData[
  FormBox["4", TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "245c1cd1-2993-40e0-b8f2-67bf48097f9e"],
 "."
}], "Example",
 CellID->33,ExpressionUUID->"d0bfe683-df90-4f61-85a0-a33074396640"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"{", " ", 
  RowBox[{
   RowBox[{"maxSidon", "[", " ", "21", " ", "]"}], ",", " ", 
   RowBox[{"maxSidon", "[", " ", "22", " ", "]"}]}], " ", "}"}]], "Input",
 CellID->34,ExpressionUUID->"bb64a251-acd0-4402-9f43-28363f305ab4"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"5", ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "1", ",", "4", ",", "14", ",", "16"}], "}"}]}], "}"}],
    ",", 
   RowBox[{"{", 
    RowBox[{"4", ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "1", ",", "3", ",", "7"}], "}"}]}], "}"}]}], 
  "}"}]], "Output",
 CellID->35,ExpressionUUID->"413ac63c-ec7d-4cc4-9706-d44704c24cd1"]
}, {2}]],

Cell["Ruliology", "Section",
 CellID->36,ExpressionUUID->"50b0ccef-117b-40b7-adf0-6486bce80aed"],

Cell[TextData[{
 "The values of ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["s", "TI"], "(", 
    StyleBox["n", "TI"], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "397c514f-66f3-40e6-b21b-3a6de41679c4"],
 " for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"3", "\[LessEqual]", 
    StyleBox["n", "TI"], "\[LessEqual]", "40"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "9608e738-6f12-4c3b-82ee-d56577356c54"],
 " were computed twice, by two searches written independently: a direct \
enumeration of subsets in decreasing size, and a backtracking search that \
extends a partial set only while its differences stay distinct. The two agree \
on ",
 Cell[BoxData[
  FormBox[
   RowBox[{"3", "\[LessEqual]", 
    StyleBox["n", "TI"], "\[LessEqual]", "26"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "72753d77-0582-4147-848d-600aa4caf28d"],
 ", where the direct enumeration is still cheap, and the backtracking search \
alone carries ",
 Cell[BoxData[
  FormBox[
   RowBox[{"27", "\[LessEqual]", 
    StyleBox["n", "TI"], "\[LessEqual]", "40"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1afba1d6-8434-4a2f-a27a-76c36badcdc9"],
 ". Over that range ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["s", "TI"], 
    RowBox[{"(", 
     StyleBox["n", "TI"], ")"}], "\[LongEqual]", 
    StyleBox["b", "TI"], 
    RowBox[{"(", 
     StyleBox["n", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "a1451d13-c954-4602-a277-fe13f475cc48"],
 " except at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", "22", ",", "32", ",", "33", ",", 
    "34"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "0975e789-c6ae-4c2f-94e5-67166cc1e58d"],
 ", which is the evidence behind ",
 ButtonBox["Question ",
  BaseStyle->"Citation",
  ButtonData->"Q:Finite"],
 ButtonBox[
 CounterBox["Section", "Q:Finite"],
  BaseStyle->"Citation",
  ButtonData->"Q:Finite"],
 ButtonBox[".",
  BaseStyle->"Citation",
  ButtonData->"Q:Finite"],
 ButtonBox[
 CounterBox["Theorem", "Q:Finite"],
  BaseStyle->"Citation",
  ButtonData->"Q:Finite"],
 "; the nineteen maximum sets used by ",
 ButtonBox["Proposition ",
  BaseStyle->"Citation",
  ButtonData->"Prop:First"],
 ButtonBox[
 CounterBox["Section", "Prop:First"],
  BaseStyle->"Citation",
  ButtonData->"Prop:First"],
 ButtonBox[".",
  BaseStyle->"Citation",
  ButtonData->"Prop:First"],
 ButtonBox[
 CounterBox["Theorem", "Prop:First"],
  BaseStyle->"Citation",
  ButtonData->"Prop:First"],
 " are the witnesses returned for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"3", "\[LessEqual]", 
    StyleBox["n", "TI"], "\[LessEqual]", "21"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d6b324df-adf7-4ed4-ad5e-29bb06279e37"],
 "."
}], "Text",
 CellID->37,ExpressionUUID->"8c5c6b87-c75e-447f-b7d9-a04c43212a02"],

Cell[BoxData[
 RowBox[{"Grid", "[", " ", 
  RowBox[{"Table", "[", " ", 
   RowBox[{
    RowBox[{"{", " ", 
     RowBox[{"n", ",", " ", 
      RowBox[{"bound", "[", " ", "n", " ", "]"}], ",", " ", 
      RowBox[{"maxSidonBT", "[", " ", "n", " ", "]"}]}], " ", "}"}], ",", " ", 
    RowBox[{"{", " ", 
     RowBox[{"n", ",", " ", "3", ",", " ", "40"}], " ", "}"}]}], " ", "]"}], 
  " ", "]"}]], "Input",
 CellID->38,ExpressionUUID->"55a62512-f61a-4272-a2ba-62747e6c9df9"],

Cell["Outlook", "Section",
 CellID->39,ExpressionUUID->"4adbe4aa-84d1-49ef-bf3f-6f36397fc02f"],

Cell[TextData[{
 "Is the set ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
     StyleBox["n", "TI"], ":", 
     StyleBox["s", "TI"], 
     RowBox[{"(", 
      StyleBox["n", "TI"], ")"}], "<", 
     StyleBox["b", "TI"], 
     RowBox[{"(", 
      StyleBox["n", "TI"], ")"}]}], "}"}], TraditionalForm]], "InlineFormula",
  
  FontSize->0.9 Inherited,ExpressionUUID->
  "a3c4acf5-96c9-47c1-b1a0-0dc49d7c53d4"],
 " finite?"
}], "Question",
 CellTags->"Q:Finite",
 CellID->40,ExpressionUUID->"cb80f915-9092-4630-8b5b-bd8d048d826f"],

Cell[TextData[{
 "A single construction attaining ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["b", "TI"], "(", 
    StyleBox["n", "TI"], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "22388c33-014d-4a4c-85a2-5234fd6bda6b"],
 " for all ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4ac7afc8-ebe2-44df-a992-deccc3eeab8f"],
 " beyond some point would settle it one way, and an infinite family of \
failures the other; the first unchecked case is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", "41"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "55f43e4e-d2c8-4a27-92fe-d2b06816ed49"],
 "."
}], "Text",
 CellID->41,ExpressionUUID->"505d53a7-c62c-4ece-a243-fd83b9eb5789"],

Cell["Retained material (no journal)", "Section",
 CellID->42,ExpressionUUID->"6219ea40-9b5d-4a6f-b887-bfc61663c587"],

Cell[TextData[{
 StyleBox["[ Retained \[LongDash] no journal ]", "TI"],
 " The material below is not paper content. It fails the settled tier and its \
home is the journal, which is off in this project, so it was retained here on \
the operator's ruling rather than dropped. Each item is removable in one pass \
once a journal exists."
}], "Text",
 CellID->43,ExpressionUUID->"4aea8971-26de-4e1e-838f-738736699f28"],

Cell[TextData[{
 StyleBox["[ Retained \[LongDash] no journal ]", "TI"],
 " Hedged claim. For every ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["k", "TI"], "\[GreaterEqual]", "3"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ed88bbc0-e0d0-44ca-89b4-9d3095299427"],
 " the bound ",
 Cell[BoxData[
  FormBox[
   StyleBox["b", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "5c604912-d325-4f7f-b2d5-cc1618b86b39"],
 " appears to be attained at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", 
    SuperscriptBox[
     StyleBox["k", "TI"], "2"], "-", 
    StyleBox["k", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d852ad85-fec1-4fe1-9773-a0cb501b77f4"],
 " exactly when ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["k", "TI"], "-", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "71e1d7a1-6d12-4b98-b496-dfd73dea92bf"],
 " is a prime power, the first failure of that form being ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", "43"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f48bca79-1cb1-4e52-be15-5e600679c27f"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["s", "TI"], 
    RowBox[{"(", "43", ")"}], "\[LongEqual]", "6", "<", "7"}], 
   TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "060ad8e6-0133-442f-99b8-23d9b2fe014c"],
 ". Checked for ",
 Cell[BoxData[
  FormBox[
   RowBox[{"3", "\[LessEqual]", 
    StyleBox["k", "TI"], "\[LessEqual]", "7"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "d6405dbb-a145-402c-9566-c217580f8fa1"],
 " only, and unproved for every ",
 Cell[BoxData[
  FormBox[
   StyleBox["k", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ea509922-b461-474a-b2d5-f87766664f85"],
 "."
}], "Remark",
 CellID->44,ExpressionUUID->"ceb5ebaf-f04c-4f2f-a530-af8ecc50d1ce"],

Cell[TextData[{
 StyleBox["[ Retained \[LongDash] no journal ]", "TI"],
 " Failed attempt. To prove attainment in general we tried the greedy Mian\
\[Dash]Chowla prefixes ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{
    "0", ",", "1", ",", "3", ",", "7", ",", "12", ",", "20", ",", 
     "\[Ellipsis]"}], "}"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "cd050e07-a43d-4279-a257-0e666483dfdd"],
 " reduced modulo ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ebf73b7f-71f1-4c17-b76f-dba1adb9892a"],
 ", which are the maximum sets returned at ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", "25"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "764b0b44-6b7a-4327-b6e5-f0902cfd2cc8"],
 " and ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", "26"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "1743db34-12a7-442a-9e0b-ee97cf46d4db"],
 ". The route is dead: the prefix ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "3", ",", "7", ",", "12"}], "}"}], 
   TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "08ad4636-1021-452e-977b-b505c809d6a9"],
 " is not a Sidon set in ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["Z",
     FontSlant->"Plain"], "21"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "4327ede4-307c-4af3-b290-6913c407379a"],
 ", where ",
 Cell[BoxData[
  FormBox[
   RowBox[{"{", 
    RowBox[{"0", ",", "1", ",", "4", ",", "14", ",", "16"}], "}"}], 
   TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "774c8299-f77e-40e1-a5e4-054ce3b024b9"],
 " is."
}], "Remark",
 CellID->45,ExpressionUUID->"f8a4a87a-61f2-4a10-84f9-b1724f2e0f76"],

Cell[TextData[{
 StyleBox["[ Retained \[LongDash] no journal ]", "TI"],
 " Unresolved [lookup]. Singer's theorem is said to give a Sidon set of size ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["q", "TI"], "+", "1"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "fca8180d-ee65-4ef9-9c04-c2b0327b3345"],
 " in ",
 Cell[BoxData[
  FormBox[
   SubscriptBox[
    StyleBox["Z",
     FontSlant->"Plain"], 
    RowBox[{
     SuperscriptBox[
      StyleBox["q", "TI"], "2"], "+", 
     StyleBox["q", "TI"], "+", "1"}]], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "b657fd71-7517-448c-80f2-942446973b2d"],
 " for every prime power ",
 Cell[BoxData[
  FormBox[
   StyleBox["q", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bb4a1798-53f3-4c70-93a8-cef3603e3923"],
 ", which would attain the bound at those ",
 Cell[BoxData[
  FormBox[
   StyleBox["n", "TI"], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "ab24917f-df2e-4d89-8a40-07aa2f9bcd02"],
 ". No source was read, so the statement is unverified here, and the hedged \
claim above and ",
 ButtonBox["Question ",
  BaseStyle->"Citation",
  ButtonData->"Q:Finite"],
 ButtonBox[
 CounterBox["Section", "Q:Finite"],
  BaseStyle->"Citation",
  ButtonData->"Q:Finite"],
 ButtonBox[".",
  BaseStyle->"Citation",
  ButtonData->"Q:Finite"],
 ButtonBox[
 CounterBox["Theorem", "Q:Finite"],
  BaseStyle->"Citation",
  ButtonData->"Q:Finite"],
 " both lean on it."
}], "Remark",
 CellID->46,ExpressionUUID->"f8f66bb1-4482-47ba-a7f4-67e77fc6fe99"],

Cell[CellGroupData[{

Cell["Initialization", "Section",
 CellID->47,ExpressionUUID->"e6771e66-8542-46c3-8e5e-81b1dc6454bc"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"bound", "[", " ", "n_", " ", "]"}], " ", ":=", " ", 
    RowBox[{"Floor", "[", " ", 
     RowBox[{
      RowBox[{"(", " ", 
       RowBox[{"1", " ", "+", " ", 
        RowBox[{"Sqrt", "[", " ", 
         RowBox[{
          RowBox[{"4", " ", "n"}], " ", "-", " ", "3"}], " ", "]"}]}], " ", 
       ")"}], "/", "2"}], " ", "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"sidonQ", "[", " ", 
     RowBox[{"a_List", ",", " ", "n_"}], " ", "]"}], " ", ":=", " ", 
    RowBox[{"With", "[", " ", 
     RowBox[{
      RowBox[{"{", " ", 
       RowBox[{"d", " ", "=", " ", 
        RowBox[{"Mod", "[", " ", 
         RowBox[{
          RowBox[{"Flatten", " ", "@", " ", 
           RowBox[{"Table", "[", " ", 
            RowBox[{
             RowBox[{"x", " ", "-", " ", "y"}], ",", " ", 
             RowBox[{"{", " ", 
              RowBox[{"x", ",", " ", "a"}], " ", "}"}], ",", " ", 
             RowBox[{"{", " ", 
              RowBox[{"y", ",", " ", "a"}], " ", "}"}]}], " ", "]"}]}], ",", 
          " ", "n"}], " ", "]"}]}], " ", "}"}], ",", "\n", "  ", 
      RowBox[{
       RowBox[{"DuplicateFreeQ", "[", " ", 
        RowBox[{"DeleteCases", "[", " ", 
         RowBox[{"d", ",", " ", "0"}], " ", "]"}], " ", "]"}], " ", "&&", " ", 
       RowBox[{
        RowBox[{"Count", "[", " ", 
         RowBox[{"d", ",", " ", "0"}], " ", "]"}], " ", "==", " ", 
        RowBox[{"Length", "[", " ", "a", " ", "]"}]}]}]}], " ", "]"}]}], 
   ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"maxSidon", "[", " ", "n_", " ", "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", " ", 
     RowBox[{
      RowBox[{"{", " ", 
       RowBox[{"k", ",", " ", "s"}], " ", "}"}], ",", "\n", "  ", 
      RowBox[{"Do", "[", " ", 
       RowBox[{
        RowBox[{
         RowBox[{"s", " ", "=", " ", 
          RowBox[{"SelectFirst", "[", " ", 
           RowBox[{
            RowBox[{"Subsets", "[", " ", 
             RowBox[{
              RowBox[{"Range", "[", " ", 
               RowBox[{"n", " ", "-", " ", "1"}], " ", "]"}], ",", " ", 
              RowBox[{"{", " ", 
               RowBox[{"k", " ", "-", " ", "1"}], " ", "}"}]}], " ", "]"}], ",",
             " ", 
            RowBox[{
             RowBox[{"sidonQ", "[", " ", 
              RowBox[{
               RowBox[{"Prepend", "[", " ", 
                RowBox[{"#", ",", " ", "0"}], " ", "]"}], ",", " ", "n"}], 
              " ", "]"}], " ", "&"}]}], " ", "]"}]}], ";", "\n", "      ", 
         RowBox[{"If", "[", " ", 
          RowBox[{
           RowBox[{"s", " ", "=!=", " ", 
            RowBox[{"Missing", "[", " ", "\"\<NotFound\>\"", " ", "]"}]}], ",",
            " ", 
           RowBox[{"Return", "[", " ", 
            RowBox[{
             RowBox[{"{", " ", 
              RowBox[{"k", ",", " ", 
               RowBox[{"Prepend", "[", " ", 
                RowBox[{"s", ",", " ", "0"}], " ", "]"}]}], " ", "}"}], ",", 
             " ", "Module"}], " ", "]"}]}], " ", "]"}]}], ",", "\n", "      ", 
        RowBox[{"{", " ", 
         RowBox[{"k", ",", " ", 
          RowBox[{"bound", "[", " ", "n", " ", "]"}], ",", " ", "1", ",", " ", 
          RowBox[{"-", "1"}]}], " ", "}"}]}], " ", "]"}]}], " ", "]"}]}], 
   ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"hasSidonK", "[", " ", 
     RowBox[{"n_", ",", " ", "k_"}], " ", "]"}], " ", ":=", " ", 
    RowBox[{"Module", "[", " ", 
     RowBox[{
      RowBox[{"{", " ", 
       RowBox[{
        RowBox[{"res", " ", "=", " ", "False"}], ",", " ", "ext"}], " ", 
       "}"}], ",", "\n", "  ", 
      RowBox[{
       RowBox[{
        RowBox[{"ext", "[", " ", 
         RowBox[{"a_", ",", " ", "used_"}], " ", "]"}], " ", ":=", " ", 
        RowBox[{"Module", "[", " ", 
         RowBox[{
          RowBox[{"{", " ", "d", " ", "}"}], ",", "\n", "    ", 
          RowBox[{
           RowBox[{"If", "[", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"Length", "[", " ", "a", " ", "]"}], " ", "==", " ", 
              "k"}], ",", " ", 
             RowBox[{
              RowBox[{"res", " ", "=", " ", "True"}], ";", " ", 
              RowBox[{"Return", "[", " ", "]"}]}]}], " ", "]"}], ";", "\n", 
           "    ", 
           RowBox[{"Do", "[", " ", 
            RowBox[{
             RowBox[{
              RowBox[{"d", " ", "=", " ", 
               RowBox[{"Join", "[", " ", 
                RowBox[{
                 RowBox[{"Mod", "[", " ", 
                  RowBox[{
                   RowBox[{"c", " ", "-", " ", "a"}], ",", " ", "n"}], " ", 
                  "]"}], ",", " ", 
                 RowBox[{"Mod", "[", " ", 
                  RowBox[{
                   RowBox[{"a", " ", "-", " ", "c"}], ",", " ", "n"}], " ", 
                  "]"}]}], " ", "]"}]}], ";", "\n", "        ", 
              RowBox[{"If", "[", " ", 
               RowBox[{
                RowBox[{
                 RowBox[{"DuplicateFreeQ", "[", " ", "d", " ", "]"}], " ", "&&",
                  " ", 
                 RowBox[{
                  RowBox[{"Intersection", "[", " ", 
                   RowBox[{"used", ",", " ", "d"}], " ", "]"}], " ", "===", 
                  " ", 
                  RowBox[{"{", " ", "}"}]}]}], ",", " ", 
                RowBox[{"ext", "[", " ", 
                 RowBox[{
                  RowBox[{"Append", "[", " ", 
                   RowBox[{"a", ",", " ", "c"}], " ", "]"}], ",", " ", 
                  RowBox[{"Join", "[", " ", 
                   RowBox[{"used", ",", " ", "d"}], " ", "]"}]}], " ", 
                 "]"}]}], " ", "]"}], ";", "\n", "        ", 
              RowBox[{"If", "[", " ", 
               RowBox[{"res", ",", " ", 
                RowBox[{"Return", "[", " ", "]"}]}], " ", "]"}]}], ",", " ", 
             RowBox[{"{", " ", 
              RowBox[{"c", ",", " ", 
               RowBox[{
                RowBox[{"Last", "[", " ", "a", " ", "]"}], " ", "+", " ", 
                "1"}], ",", " ", 
               RowBox[{"n", " ", "-", " ", "1"}]}], " ", "}"}]}], " ", 
            "]"}]}]}], " ", "]"}]}], ";", "\n", "  ", 
       RowBox[{"ext", "[", " ", 
        RowBox[{
         RowBox[{"{", " ", "0", " ", "}"}], ",", " ", 
         RowBox[{"{", " ", "}"}]}], " ", "]"}], ";", " ", "res"}]}], " ", 
     "]"}]}], ";"}], "\n"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"maxSidonBT", "[", " ", "n_", " ", "]"}], " ", ":=", " ", 
   RowBox[{"SelectFirst", "[", " ", 
    RowBox[{
     RowBox[{"Range", "[", " ", 
      RowBox[{
       RowBox[{"bound", "[", " ", "n", " ", "]"}], ",", " ", "1", ",", " ", 
       RowBox[{"-", "1"}]}], " ", "]"}], ",", " ", 
     RowBox[{
      RowBox[{"hasSidonK", "[", " ", 
       RowBox[{"n", ",", " ", "#"}], " ", "]"}], " ", "&"}]}], " ", "]"}]}], 
  ";"}]}], "Input",
 InitializationCell->True,
 CellID->48,ExpressionUUID->"c4a7f3a8-09e3-42fa-8c3f-e14b14f4a7c4"],

