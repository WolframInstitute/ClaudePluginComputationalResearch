 ButtonBox[
 CounterBox["Theorem", "Def:MaxSize"],
  BaseStyle->"Citation",
  ButtonData->"Def:MaxSize"],
 ".",
 " ",
 StyleBox["\[EmptySquare]", "QED"]
}], "Proof",
 CellID->24,ExpressionUUID->"209cd4e8-86eb-4587-b800-b57abaf60e52"],

Cell[TextData[{
 "Since ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["s", "TI"], "(", 
    StyleBox["n", "TI"], ")"}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "46905b49-2f30-4879-a074-4a7d1cc6c828"],
 " is an integer, ",
 ButtonBox["(",
  BaseStyle->"Citation",
  ButtonData->"Thm:Bound"],
 ButtonBox[
 CounterBox["DisplayFormulaNumbered", "Thm:Bound"],
  BaseStyle->"Citation",
  ButtonData->"Thm:Bound"],
 ButtonBox[")",
  BaseStyle->"Citation",
  ButtonData->"Thm:Bound"],
 " gives ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["s", "TI"], 
    RowBox[{"(", 
     StyleBox["n", "TI"], ")"}], "\[LessEqual]", 
    StyleBox["b", "TI"], 
    RowBox[{"(", 
     StyleBox["n", "TI"], ")"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "6a86a9ff-c163-49ca-b9bf-46c7ffab5a3f"],
 " with ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["b", "TI"], 
    RowBox[{"(", 
     StyleBox["n", "TI"], ")"}], "\[LongEqual]", 
    RowBox[{"\[LeftFloor]", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"1", "+", 
        SqrtBox[
         RowBox[{"4", 
          StyleBox["n", "TI"], "-", "3"}]]}], ")"}], "/", "2"}], 
     "\[RightFloor]"}]}], TraditionalForm]], "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "affc3bf0-096b-4a0b-a5b8-edc8bec2aea3"],
 ", and it is this integer form that the next section tests."
}], "Remark",
 CellID->25,ExpressionUUID->"e587699e-49ed-4c25-a3cc-a31bd9e61184"],

Cell[TextData[{
 "At ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["n", "TI"], "\[LongEqual]", "22"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "bc4bed01-efc7-4446-87c6-352d480d3948"],
 " the bound is ",
 Cell[BoxData[
  FormBox[
   RowBox[{
    StyleBox["b", "TI"], 
    RowBox[{"(", "22", ")"}], "\[LongEqual]", "5"}], TraditionalForm]], 
  "InlineFormula",
  FontSize->0.9 Inherited,ExpressionUUID->
  "f940eb99-1c6a-4d9a-a020-9d84db38171a"],
 "."
}], "Example",
 CellID->26,ExpressionUUID->"a8bc003e-5c3a-4108-91e8-037132fb91cb"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Floor", "[", " ", 
  RowBox[{
   RowBox[{"(", " ", 
    RowBox[{"1", " ", "+", " ", 
     RowBox[{"Sqrt", "[", " ", 
      RowBox[{
       RowBox[{"4", "*", "22"}], " ", "-", " ", "3"}], " ", "]"}]}], " ", 
    ")"}], "/", "2"}], " ", "]"}]], "Input",
